{
  "name": "openclaw-linq-plugin",
  "version": "1.0.0",
  "description": "Linq iMessage channel plugin for OpenClaw — real iMessage over API, no Mac required",
  "type": "module",
  "main": "index.ts",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/linq-team/openclaw-linq-plugin.git"
  },
  "keywords": [
    "openclaw",
    "linq",
    "imessage",
    "channel",
    "plugin",
    "sms",
    "messaging"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.6.0"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "typescript": "^5.8.3",
    "vitest": "^3.2.2"
  },
  "openclaw": {
    "extensions": [
      "./index.ts"
    ],
    "setupEntry": "./setup-entry.ts",
    "channel": {
      "id": "linq",
      "label": "Linq",
      "selectionLabel": "Linq (Messaging API)",
      "blurb": "iMessage, RCS, and SMS through the Linq API."
    }
  }
}
